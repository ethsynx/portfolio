# Copia de referencia. El archivo real es .env y lo crea `npm run admin:configurar`.
# No subas .env a ningún repositorio.

# Usuario del panel /admin
ADMIN_USUARIO=
# Hash scrypt de la contraseña (lo genera el script; no escribas aquí la contraseña)
ADMIN_HASH=

# Carpeta persistente para la base de datos y los archivos subidos (por defecto ./datos)
# DATA_DIR=/var/lib/portfolio-diego

# Ponlo a 1 solo si la web está detrás de un proxy inverso (Nginx, Caddy, Cloudflare Tunnel…)
# TRUST_PROXY=1

# Puerto del servidor en producción (por defecto 3000)
# PORT=3000
